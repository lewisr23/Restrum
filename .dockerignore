# Dependencies and build output are produced inside the image; copying the
# host's copies in would both bloat the context and risk shipping artefacts
# built against a different platform.
vendor
node_modules
frontend/node_modules
frontend/build
public/build
public/hot
public/storage

# Local state and secrets.
.env
.env.*
!.env.example
storage/*.key
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
database/*.sqlite

.git
.github
.gitignore
.claude
.idea
.vscode

*.md
.phpunit.result.cache
.phpunit.cache
