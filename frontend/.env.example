# Create React App inlines every REACT_APP_* value into the bundle at BUILD
# time, not at runtime. Setting these on a server after `npm run build` does
# nothing: they have to be present when the build runs, which is why
# docker-compose.yml passes them as build arguments rather than environment.

# Where the API lives. Three meaningful cases:
#   unset       -> http://localhost:8500, matching `php artisan serve --port=8500`
#   empty       -> same origin, for when Laravel or nginx serves the SPA itself
#   a URL       -> that host, for a split deployment
# The Compose stack leaves this empty, since nginx serves both from one origin.
REACT_APP_API_BASE_URL=http://localhost:8500

# How the BROWSER reaches Reverb for live messaging. These describe the
# published port as seen from outside, so under Compose they are localhost:8081
# even though the server-side REVERB_* values point at the container.
#
# The app key is not a secret. It identifies which Reverb app to connect to,
# the same way a Pusher app key does. Private channels are kept private by the
# authorization check at /broadcasting/auth, not by hiding this value.
REACT_APP_REVERB_APP_KEY=local-development-key
REACT_APP_REVERB_HOST=localhost
REACT_APP_REVERB_PORT=8080
REACT_APP_REVERB_SCHEME=http
