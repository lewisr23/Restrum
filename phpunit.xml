<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Tests run against MySQL rather than the sqlite :memory: default.
            Slower, but the app only ever runs on MySQL and the differences
            are not cosmetic: the schema uses MySQL enum columns, and the two
            engines disagree about the clock - MySQL's NOW() is the server's
            local time, sqlite's CURRENT_TIMESTAMP is UTC. A real timestamp
            bug here was invisible under sqlite for exactly that reason.
            CI points these same variables at its MySQL service container.
        -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="restrum_test"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <!--
            Search is off by default in tests, and forced so a developer's
            own .env cannot switch it on. The tests that need it turn it on
            themselves, which keeps every other test off the network, and
            the index name is pinned to a throwaway so a test run can never
            write into the index the development app is reading from. That
            is not hypothetical: it happened.
        -->
        <env name="ELASTICSEARCH_ENABLED" value="false" force="true"/>
        <env name="ELASTICSEARCH_INDEX" value="listings_test" force="true"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
