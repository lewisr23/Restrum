APP_NAME=Restrum
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Laravel's default is 8000, but the frontend looks for the API on 8500 when
# REACT_APP_API_BASE_URL is unset, so `php artisan serve --port=8500` and this
# value agree. See frontend/src/lib/config.ts.
APP_URL=http://localhost:8500

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL rather than sqlite, and not just a preference: the schema uses MySQL
# enum columns, and the two engines disagree about the clock in ways that have
# already hidden one real bug. The test suite is pinned to MySQL for the same
# reason - see the comment in phpunit.xml.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=restrum
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# predis, not phpredis. composer.json requires predis/predis and the Docker
# image builds no phpredis extension, so the pure PHP client is the one that
# is actually present.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Live messaging. `log` is Laravel's default and silently discards broadcasts,
# which makes the chat look merely broken rather than unconfigured, so this
# ships pointing at Reverb. Start it with `php artisan reverb:start`.
BROADCAST_CONNECTION=reverb

# Development credentials. Any non-empty values work locally, since Reverb
# checks them against itself; generate real ones for anything deployed.
REVERB_APP_ID=local-development-id
REVERB_APP_KEY=local-development-key
REVERB_APP_SECRET=local-development-secret

# Where the SERVER reaches Reverb to publish events. The browser uses its own
# REACT_APP_REVERB_* values, which need not match: under Compose these are the
# service name and container port, while the browser sees a published port.
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Listing search. With this off the API falls back to a SQL LIKE query, so a
# fresh clone works with no cluster running.
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_HOST=http://localhost:9200
# Index name, so several environments can share one cluster.
ELASTICSEARCH_INDEX=listings
# Request timeout in seconds. Kept short because search is not allowed to hold
# a page up; a slow cluster falls back to SQL rather than waiting.
ELASTICSEARCH_TIMEOUT=2.0
# Host port Compose publishes the cluster on. Change it if something already
# holds 9200 on your machine.
ELASTICSEARCH_PORT=9200

# Where uploaded listing media is written. The local public disk is fine for
# development, but a container filesystem does not survive a restart, so any
# hosted deployment must point this at object storage.
#   MEDIA_DISK=s3
#   AWS_ACCESS_KEY_ID=        AWS_SECRET_ACCESS_KEY=
#   AWS_DEFAULT_REGION=       AWS_BUCKET=
#   AWS_URL=                  the public base URL files are served from
# Google Cloud Storage works through the same s3 driver, with
# AWS_ENDPOINT=https://storage.googleapis.com and an HMAC key pair.
MEDIA_DISK=public

# Stripe. Payments run on Connect with separate charges and transfers: the
# platform takes the card payment, holds the money, and transfers the seller's
# share only once the buyer confirms the instrument arrived. That gap is what
# buyer protection actually is, and it is why a destination charge (which pays
# the seller at once) is not what this uses.
#
# Test keys are safe to run in production against a real domain - the whole
# payment flow works end to end, it just moves no real money, so switching to
# live keys is a config change rather than a rebuild.
STRIPE_KEY=
STRIPE_SECRET=

# From `stripe listen` locally, or the endpoint's signing secret in the Stripe
# dashboard once https://restrum.uk/api/stripe/webhook is registered. Webhooks
# are rejected outright when this is unset: an unverified webhook is an open
# endpoint that moves money on request.
STRIPE_WEBHOOK_SECRET=

# Overrides for the marketplace policy in config/services.php. The defaults
# are 5% platform fee, a 30 minute checkout reservation, and auto-release to
# the seller 14 days after payment if the buyer never confirms.
# STRIPE_PLATFORM_FEE_PERCENT=5
# STRIPE_RESERVATION_MINUTES=30
# STRIPE_AUTO_RELEASE_DAYS=14

# Where sellers land after Connect onboarding. The buyer's own return from
# payment is handled in the browser now that the card form is mounted on our
# own checkout page, so this is only about Connect. The API and the React app
# are not the same origin in development, so it cannot be derived from
# APP_URL.
FRONTEND_URL=http://localhost:3000

# The AI gear adviser on the browse page. Leave blank and the widget simply
# does not render: no key, no feature, no error. Get one from
# https://console.anthropic.com. Every question costs money, so the endpoint
# behind it is rate limited per IP.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
