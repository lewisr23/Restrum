APP_NAME=Restrum
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Laravel's default is 8000, but the frontend looks for the API on 8500 when
# REACT_APP_API_BASE_URL is unset, so `php artisan serve --port=8500` and this
# value agree. See frontend/src/lib/config.ts.
APP_URL=http://localhost:8500

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL rather than sqlite, and not just a preference: the schema uses MySQL
# enum columns, and the two engines disagree about the clock in ways that have
# already hidden one real bug. The test suite is pinned to MySQL for the same
# reason - see the comment in phpunit.xml.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=restrum
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# predis, not phpredis. composer.json requires predis/predis and the Docker
# image builds no phpredis extension, so the pure PHP client is the one that
# is actually present.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Live messaging. `log` is Laravel's default and silently discards broadcasts,
# which makes the chat look merely broken rather than unconfigured, so this
# ships pointing at Reverb. Start it with `php artisan reverb:start`.
BROADCAST_CONNECTION=reverb

# Development credentials. Any non-empty values work locally, since Reverb
# checks them against itself; generate real ones for anything deployed.
REVERB_APP_ID=local-development-id
REVERB_APP_KEY=local-development-key
REVERB_APP_SECRET=local-development-secret

# Where the SERVER reaches Reverb to publish events. The browser uses its own
# REACT_APP_REVERB_* values, which need not match: under Compose these are the
# service name and container port, while the browser sees a published port.
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Listing search. With this off the API falls back to a SQL LIKE query, so a
# fresh clone works with no cluster running.
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_HOST=http://localhost:9200
# Index name, so several environments can share one cluster.
ELASTICSEARCH_INDEX=listings
# Request timeout in seconds. Kept short because search is not allowed to hold
# a page up; a slow cluster falls back to SQL rather than waiting.
ELASTICSEARCH_TIMEOUT=2.0
# Host port Compose publishes the cluster on. Change it if something already
# holds 9200 on your machine.
ELASTICSEARCH_PORT=9200

# Where uploaded listing media is written. The local public disk is fine for
# development, but a container filesystem does not survive a restart, so any
# hosted deployment must point this at object storage.
#   MEDIA_DISK=s3
#   AWS_ACCESS_KEY_ID=        AWS_SECRET_ACCESS_KEY=
#   AWS_DEFAULT_REGION=       AWS_BUCKET=
#   AWS_URL=                  the public base URL files are served from
# Google Cloud Storage works through the same s3 driver, with
# AWS_ENDPOINT=https://storage.googleapis.com and an HMAC key pair.
MEDIA_DISK=public
