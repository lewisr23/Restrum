# Copy to .env.production ON THE SERVER and fill in. Never commit the filled
# version: .gitignore already excludes .env.production, and .dockerignore
# keeps every .env out of the image, so the real file exists in exactly one
# place and reaches the containers through env_file rather than being baked
# into a layer.
#
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml run --rm --no-deps app php artisan key:generate --show
#
# Two rules that will otherwise cost you an afternoon:
#
#   1. Avoid $ in any generated password. Compose runs this file through
#      variable interpolation as well as handing it to the containers, so a
#      literal $ has to be written $$ and is a good way to end up with a
#      database password that differs between the server and the client.
#      Alphanumeric passwords sidestep the whole problem:
#        openssl rand -hex 24
#
#   2. Do not set DB_HOST, REDIS_HOST, ELASTICSEARCH_HOST, REVERB_HOST,
#      QUEUE_CONNECTION or BROADCAST_CONNECTION here. Those describe the
#      compose network rather than this deployment, so docker-compose.prod.yml
#      sets them and will override anything written here.

APP_NAME=Restrum
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://restrum.uk

# Where a seller lands after Connect onboarding. The API and the React bundle
# are the same origin in production, unlike in development, so this is the
# same value as APP_URL. The buyer's return from payment is not set here: the
# card form is mounted on our own checkout page, so the browser handles it.
FRONTEND_URL=https://restrum.uk

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# warning rather than debug: production logs are for things that went wrong,
# and a 40GB disk fills faster than you would think at debug level.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

BCRYPT_ROUNDS=12

# MySQL. The compose file creates this user and database on first boot from
# these values, so changing them later means changing them in the database
# too, not just here.
DB_DATABASE=restrum
DB_USERNAME=restrum
DB_PASSWORD=
# Only used to initialise the server. The application never connects as root.
DB_ROOT_PASSWORD=

# Redis is already running for the queue, and it is a better home for the
# cache than the database: the gear adviser's rate limiter and every other
# throttle live here, and they are read far more often than they are written.
CACHE_STORE=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Uploaded listing media. The public disk is backed by the storage-data
# volume, which survives container restarts and rebuilds but lives on this
# one server: it is not backed up by anything unless you arrange it, and it
# does not survive the server being destroyed. Moving to object storage is
# the fix when that matters; see the MEDIA_DISK notes in .env.example.
FILESYSTEM_DISK=local
MEDIA_DISK=public

# Live messaging. Generate all three; they are shared secrets between the
# app and the Reverb server rather than anything a user supplies.
#
# REVERB_APP_KEY must match the value compose bakes into the JS bundle, which
# it reads from this same file, so they cannot drift as long as you rebuild
# after changing it. Changing it DOES require a rebuild, not just a restart.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

ELASTICSEARCH_INDEX=listings
ELASTICSEARCH_TIMEOUT=2.0

# Mail. Laravel's default discards mail silently, which is the wrong failure
# for password resets and email verification on a site with real users.
# Kept as log here so a first deploy does not need an SMTP account to come
# up, and because REQUIRE_EMAIL_VERIFICATION below must stay false while it
# is log.
#
# To switch it on with Brevo (free tier, 300 mails a day, which is the plan
# that keeps this inside the GBP 15/month budget):
#   1. Verify restrum.uk as a sender domain in Brevo and add the DKIM and
#      SPF records it gives you to Cloudflare DNS. Skipping this is how mail
#      ends up in spam rather than failing loudly.
#   2. Create an SMTP key in Brevo. The username is the account's login
#      email, the password is that generated key, NOT the account password.
#   3. Set MAIL_MAILER=smtp and fill in the four values below.
#   4. Only then set REQUIRE_EMAIL_VERIFICATION=true.
MAIL_MAILER=log
# MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@restrum.uk"
MAIL_FROM_NAME="${APP_NAME}"

# Whether an unconfirmed address blocks listing, paying and messaging.
# MUST stay false while MAIL_MAILER is log: with nothing able to send the
# link, nothing could ever be confirmed, and every new account would be
# locked out of the entire site with no way back.
REQUIRE_EMAIL_VERIFICATION=false

# How long a verification link lasts, in minutes.
AUTH_VERIFICATION_EXPIRE=60

# Stripe. Test keys are safe to run here against the real domain: the whole
# payment flow works end to end and moves no real money, so going live later
# is this config changing rather than anything being rebuilt.
STRIPE_KEY=
STRIPE_SECRET=

# The signing secret for the endpoint registered at
# https://restrum.uk/api/stripe/webhook in the Stripe dashboard. Note that
# this is NOT the same value as the one printed by `stripe listen` locally.
# Webhooks are rejected outright while it is unset, which is correct: an
# unverified webhook is an open endpoint that moves money on request.
STRIPE_WEBHOOK_SECRET=

# The AI gear adviser. Leave blank and the endpoint reports itself
# unavailable and the widget never renders at all - no key, no feature, no
# error, and no bill. It is the only part of this site with an open-ended
# running cost, so it is off unless you decide otherwise.
ANTHROPIC_API_KEY=
